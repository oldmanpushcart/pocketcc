{
  "manifest_version": 3,
  "name": "口袋控制中心（开发版）",
  "version": "1.0.0",
  "key": "",
  "description": "口袋控制中心 (pocketcc) — 口袋奇兵 H5 页游辅助：免扫码自动登录、自动重连、芯片祝福、泰坦祝福、联盟帮助、领域寻宝",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon.png"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://pocketcc.oss-cn-beijing.aliyuncs.com/*"
  ],
  "background": { "service_worker": "dist/background.js" },
  "action": { "default_popup": "dist/popup.html", "default_title": "口袋控制中心 · 凭证导入导出" },
  "content_scripts": [
    {
      "matches": ["https://warh5.rivergame.net/*"],
      "js": ["dist/anti-throttle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://warh5.rivergame.net/*"],
      "js": ["dist/shell.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://warh5.rivergame.net/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
