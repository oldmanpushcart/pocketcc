# EditorConfig: https://editorconfig.org
# git 侧 core.autocrlf=true（入库 LF / 工作区 CRLF），此处统一声明 LF 与仓库规范化一致
# 缩进/换行全仓交给 Prettier 统一：2 空格、LF（见 .prettierrc.json）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
