{
  "name": "pocketcc",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "口袋控制中心 (pocketcc) — 口袋奇兵 H5 页游辅助",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "prebuild": "npm run arch",
    "build:release": "node esbuild.config.mjs --release",
    "pack:release": "node scripts/package-release.mjs --channel=release",
    "pack:snapshot": "node scripts/package-release.mjs --channel=snapshot",
    "publish:release": "node scripts/publish-oss.mjs --channel=release",
    "publish:snapshot": "node scripts/publish-oss.mjs --channel=snapshot",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "arch": "depcruise extension/src --config .dependency-cruiser.cjs && node scripts/arch-size-guard.mjs && node scripts/check-slice-fns.mjs",
    "ui-snapshot": "node scripts/ui-snapshot.mjs --check",
    "ui-snapshot:baseline": "node scripts/ui-snapshot.mjs",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "node --test",
    "verify:secret-realm": "node scripts/replay/run.mjs --manifest secret-realm",
    "verify:cs-hunt": "node scripts/replay/run.mjs --manifest cs-hunt",
    "verify:radar-task": "node scripts/replay/run.mjs --manifest radar-task",
    "verify:cq26-train": "node scripts/replay/run.mjs --manifest cq26-train",
    "verify:cq26-wl-beast": "node scripts/replay/run.mjs --manifest cq26-wl-beast",
    "verify:quick-repair": "node scripts/replay/run.mjs --manifest quick-repair",
    "verify:auto-farm-skill": "node scripts/replay/run.mjs --manifest auto-farm-skill",
    "verify:cq26-ice-shake": "node scripts/replay/run.mjs --manifest cq26-ice-shake",
    "verify:cq26-feast": "node scripts/replay/run.mjs --manifest cq26-feast",
    "protocol:extract": "node scripts/protocol/extract.mjs",
    "skill:install": "node scripts/skill-install.mjs",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "knip": "^6.45.1",
    "prettier": "^3.9.9"
  }
}
