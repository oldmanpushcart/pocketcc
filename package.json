{
  "name": "pocketcc",
  "version": "1.0.0",
  "private": true,
  "description": "口袋控制中心 (pocketcc) — 口袋奇兵 H5 页游辅助",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "prebuild": "npm run arch",
    "build:release": "node esbuild.config.mjs --release && node scripts/obfuscate-release.mjs",
    "pack:friend": "node scripts/package-friend.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "arch": "depcruise extension/src --config .dependency-cruiser.cjs && node scripts/arch-size-guard.mjs",
    "test": "node --test",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "javascript-obfuscator": "^5.9.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.9"
  }
}
