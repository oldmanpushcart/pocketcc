{
    "compilerOptions": {
        "target": "es2024",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2024", "dom", "dom.iterable"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "resolveJsonModule": true,
        "baseUrl": "."
    },
    "include": [
        "extension/src/**/*",
        "dashcam/*.js",
        "tools/*.js",
        "esbuild.config.mjs"
    ],
    "exclude": [
        "node_modules",
        "extension/dist",
        "dashcam/store",
        "references"
    ]
}
